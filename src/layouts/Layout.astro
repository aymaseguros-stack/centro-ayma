---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Centro de conocimiento AYMA Advisors - Seguros y gestión de riesgos" } = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title} | Centro AYMA</title>
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/og-image.png" />
  
  <!-- Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AYMA Advisors",
    "url": "https://centro.aymaseguros.com.ar",
    "logo": "https://centro.aymaseguros.com.ar/logo-ayma.png"
  }
  </script>
</head>
<body class="bg-slate-900 text-white min-h-screen">
  <!-- Header -->
  <header class="bg-slate-800/50 border-b border-slate-700 sticky top-0 z-50 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo-ayma.png" alt="AYMA" class="w-10 h-10 rounded-lg" />
          <div>
            <span class="font-bold text-lg">Centro AYMA</span>
            <span class="text-slate-400 text-sm block">Conocimiento & Actualidad</span>
          </div>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/" class="hover:text-cyan-400 transition">Inicio</a>
          <a href="/knowledge" class="hover:text-cyan-400 transition">Knowledge</a>
          <a href="/legal" class="hover:text-cyan-400 transition">Legal</a>
          <a href="/compliance" class="hover:text-cyan-400 transition">Compliance</a>
          <a href="/noticias" class="hover:text-cyan-400 transition">Noticias</a>
        </nav>
        <a href="https://wa.me/5493416952259" target="_blank" class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg text-sm font-medium transition">
          💬 Contactar
        </a>
      </div>
    </div>
  </header>

  <!-- Main -->
  <main class="max-w-6xl mx-auto px-4 py-8">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-slate-800/30 border-t border-slate-700 mt-16">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-bold mb-3">AYMA Advisors</h3>
          <p class="text-slate-400 text-sm">Gestores de Riesgos desde 2008</p>
          <p class="text-slate-500 text-xs mt-2">PAS N° 68323 - SSN</p>
        </div>
        <div>
          <h3 class="font-bold mb-3">Secciones</h3>
          <ul class="space-y-2 text-sm text-slate-400">
            <li><a href="/knowledge" class="hover:text-white">📚 Knowledge</a></li>
            <li><a href="/legal" class="hover:text-white">⚖️ Legal</a></li>
            <li><a href="/compliance" class="hover:text-white">✅ Compliance</a></li>
            <li><a href="/noticias" class="hover:text-white">📰 Noticias</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold mb-3">Síguenos</h3>
          <div class="flex gap-4">
            <a href="https://instagram.com/aymaseguros" target="_blank" class="text-slate-400 hover:text-pink-400">IG</a>
            <a href="https://facebook.com/61584119926136" target="_blank" class="text-slate-400 hover:text-blue-400">FB</a>
            <a href="https://linkedin.com/company/ayma-seguros" target="_blank" class="text-slate-400 hover:text-blue-500">LI</a>
            <a href="https://x.com/AymaSeguros" target="_blank" class="text-slate-400 hover:text-white">X</a>
          </div>
        </div>
      </div>
      <div class="border-t border-slate-700 mt-8 pt-6 text-center text-slate-500 text-xs">
        <p>© 2025 AYMA Advisors. Todos los derechos reservados.</p>
        <p class="mt-1">Organismo de control: <a href="https://www.argentina.gob.ar/ssn" class="underline">SSN</a> | 0800-666-8400</p>
      </div>
    </div>
  </footer>
</body>
</html>
