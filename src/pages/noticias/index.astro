---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="📰 Noticias" description="Actualidad del mercado asegurador argentino">
  <h1 class="text-3xl font-bold mb-2">📰 Noticias</h1>
  <p class="text-slate-400 mb-8">Actualidad del mercado asegurador argentino</p>
  
  <div class="grid gap-6">
    <article class="bg-slate-800/50 border border-slate-700 rounded-xl p-6 hover:border-slate-600 transition">
      <span class="text-xs text-cyan-400 font-medium">PRÓXIMAMENTE</span>
      <h2 class="font-bold text-xl mt-2">Contenido en desarrollo</h2>
      <p class="text-slate-400 mt-2">Estamos preparando contenido de valor para esta sección.</p>
    </article>
  </div>
</Layout>
